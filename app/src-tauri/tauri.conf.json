{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "revui",
  "mainBinaryName": "revui-app",
  "version": "0.1.0",
  "identifier": "com.volpestyle.revui",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/revui",
      "binaries/revui-server"
    ],
    "resources": {
      "../../web/dist": "web/dist"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
